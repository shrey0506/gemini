import re
import pandas as pd

def extract_addresses(text):
    # Improved Regular Expression Pattern
    pattern = r'\b(?:\d+\s*)?(?:[A-Z][a-z]+(?:[-\s][A-Z][a-z]+)*|\b(?:of|and)\b)(?:[-\s][A-Z][a-z]+)*\b'

    # Extract matches
    matches = re.findall(pattern, text)

    # Post-processing: Removing isolated "of" and "and"
    cleaned_addresses = []
    temp_address = []

    for word in matches:
        if word.lower() in {"of", "and"}:
            temp_address.append(word)  # Keep "of" and "and" only if they are inside an address
        else:
            if temp_address:
                temp_address.append(word)
                cleaned_addresses.append(" ".join(temp_address))  # Combine valid parts into an address
                temp_address = []  # Reset for the next address
            else:
                cleaned_addresses.append(word)

    return cleaned_addresses

# Read file content (as a string)
