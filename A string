Updated Python Script for DataFrame Creation

import re
import pandas as pd

def extract_addresses(text):
    # Improved Regular Expression Pattern
    pattern = r'\b(?:\d+\s*)?(?:[A-Z][a-z]+(?:[-\s][A-Z][a-z]+)*|\b(?:of|and)\b)(?:[-\s][A-Z][a-z]+)*\b'

    # Extract matches
    matches = re.findall(pattern, text)

    # Post-processing: Removing isolated "of" and "and"
    cleaned_addresses = []
    temp_address = []

    for word in matches:
        if word.lower() in {"of", "and"}:
            temp_address.append(word)  # Keep "of" and "and" only if they are inside an address
        else:
            if temp_address:
                temp_address.append(word)
                cleaned_addresses.append(" ".join(temp_address))  # Combine valid parts into an address
                temp_address = []  # Reset for the next address
            else:
                cleaned_addresses.append(word)

    return cleaned_addresses

# Read file content (as a string)
file_path = "/mnt/data/file-9Qmk3SKhTufxRvFrPuXvrA"

with open(file_path, "r", encoding="utf-8") as file:
    output_text = file.read()  # Read as a single string

# Extracting addresses from the string
extracted_addresses = extract_addresses(output_text)

# Create DataFrame with extracted addresses
df = pd.DataFrame({"Extracted_Addresses": extracted_addresses})

# Display DataFrame
print(df)

# Save to CSV (Optional)
df.to_csv("/mnt/data/extracted_addresses.csv", index=False)


