🔹 5. DuckDuckGo Lite API (Unofficial but Free)

No API Key Needed

Website: https://lite.duckduckgo.com


Example Code:

import requests
from bs4 import BeautifulSoup

def duckduckgo_search(query, max_results=3):
    url = f"https://lite.duckduckgo.com/lite/?q={query.replace(' ', '+')}"
    headers = {"User-Agent": "Mozilla/5.0"}
    response = requests.get(url, headers=headers)

    soup = BeautifulSoup(response.text, "html.parser")
    results = []

    for link in soup.select("a.result-link")[:max_results]:
        title = link.text
        url = link["href"]
        results.append({"title": title, "url": url})

    return results

# Run search
results = duckduckgo_search("latest AI trends")
for res in results:
    print(f"Title: {res['title']}\nURL: {res['url']}\n")

✅ Pros: No API key required, avoids rate limits
❌ Cons: Limited to DuckDuckGo’s lite version


