# List of blocked words or biased topics
blocked_keywords = ["anti-muslim", "hate speech", "discrimination", "bias against", "ethnic violence"]

def is_sensitive_query(query):
    return any(keyword in query.lower() for keyword in blocked_keywords)

# Before sending the query to the model
if is_sensitive_query(user_query):
    response = "I'm sorry, but I cannot assist with that request."
else:
    response = call_llm(user_query)  # Function that interacts with the LLM

